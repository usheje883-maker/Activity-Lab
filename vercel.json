{
  "headers": [
    {
      "source": "/Games/(.*)\\.(png|jpg|jpeg|gif|webp|ico|svg|css|js)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/Files/(.*)\\.(png|jpg|jpeg|gif|webp|ico|svg|css|js)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/Tools/(.*)\\.(png|jpg|jpeg|gif|webp|ico|svg|css|js)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/Storage/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/.*\\.(html|htm)$",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}